# ── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-here-run-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adr_manager

# ── AI (optional) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email (optional, via Resend) ─────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com

# ── Encryption key for stored git tokens (32-char hex) ───────────────────────
ENCRYPTION_KEY=
